@prefix lv2:  <http://lv2plug.in/ns/lv2core#>.
@prefix doap: <http://usefulinc.com/ns/doap#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix mod: <http://moddevices.com/ns/mod#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<http://github.com/fragfz/frfz_tempo_cv>
a lv2:Plugin, mod:ControlVoltagePlugin;

doap:name "Tempo CV";
doap:license "http://spdx.org/licenses/GPL-2.0-or-later.html";
doap:developer [
    foaf:name "fragfz";
    foaf:homepage <https://github.com/fragfz>;
];

lv2:minorVersion 1;
lv2:microVersion 0;

rdfs:comment """
Tempo CV utility generates CV signals derived from host tempo.
Outputs frequency and time duration based on musical note divisions.
Supports linear and logarithmic frequency scaling.
""";

lv2:port
[
    a lv2:OutputPort, lv2:CVPort, mod:CVPort;
    lv2:index 0;
    lv2:symbol "freq_out1";
    lv2:name "Frequency 1";
    lv2:minimum 0.0 ;
    lv2:maximum 10.0 ;
],
[
    a lv2:OutputPort, lv2:CVPort, mod:CVPort;
    lv2:index 1;
    lv2:symbol "freq_out2";
    lv2:name "Frequency 2";
    lv2:minimum 0.0 ;
    lv2:maximum 10.0 ;
],
[
    a lv2:OutputPort, lv2:CVPort, mod:CVPort;
    lv2:index 2;
    lv2:symbol "time_out1";
    lv2:name "Time 1 (ms)";
    lv2:minimum 0.0 ;
    lv2:maximum 20000.0 ;
],
[
    a lv2:OutputPort, lv2:CVPort, mod:CVPort;
    lv2:index 3;
    lv2:symbol "time_out2";
    lv2:name "Time 2 (ms)";
    lv2:minimum 0.0 ;
    lv2:maximum 20000.0 ;
],
[
    a lv2:InputPort, lv2:ControlPort;
    lv2:index 4;
    lv2:symbol "division";
    lv2:name "Time Division";
    lv2:default 2;
    lv2:minimum 0;
    lv2:maximum 7;
    lv2:portProperty lv2:integer, lv2:enumeration;
    lv2:scalePoint [ rdfs:label "1/1 (whole)";      rdf:value 0 ] ;
    lv2:scalePoint [ rdfs:label "1/2 (half)";       rdf:value 1 ] ;
    lv2:scalePoint [ rdfs:label "1/4 (quarter)";    rdf:value 2 ] ;
    lv2:scalePoint [ rdfs:label "1/4T (triplet)";   rdf:value 3 ] ;
    lv2:scalePoint [ rdfs:label "1/8 (eighth)";     rdf:value 4 ] ;
    lv2:scalePoint [ rdfs:label "1/8T (triplet)";   rdf:value 5 ] ;
    lv2:scalePoint [ rdfs:label "1/16 (sixteenth)"; rdf:value 6 ] ;
    lv2:scalePoint [ rdfs:label "1/16T (triplet)";  rdf:value 7 ] ;
],
[
    a lv2:InputPort, lv2:ControlPort;
    lv2:index 5;
    lv2:symbol "min_freq";
    lv2:name "Min Frequency (Hz)";
    lv2:default 0.1;
    lv2:minimum 0.01;
    lv2:maximum 20.0;
],
[
    a lv2:InputPort, lv2:ControlPort;
    lv2:index 6;
    lv2:symbol "max_freq";
    lv2:name "Max Frequency (Hz)";
    lv2:default 20.0;
    lv2:minimum 0.01;
    lv2:maximum 20.0;
],
[
    a lv2:InputPort, lv2:ControlPort;
    lv2:index 7;
    lv2:symbol "scaling_mode";
    lv2:name "Frequency Scaling";
    lv2:default 1;
    lv2:minimum 0;
    lv2:maximum 1;
    lv2:portProperty lv2:integer, lv2:enumeration;
    lv2:scalePoint [ rdfs:label "Linear";      rdf:value 0 ] ;
    lv2:scalePoint [ rdfs:label "Logarithmic"; rdf:value 1 ] ;
],
[
    a lv2:InputPort, lv2:ControlPort;
    lv2:index 8;
    lv2:symbol "min_time";
    lv2:name "Min Time (ms)";
    lv2:default 1.0;
    lv2:minimum 0.1;
    lv2:maximum 20000.0;
],
[
    a lv2:InputPort, lv2:ControlPort;
    lv2:index 9;
    lv2:symbol "max_time";
    lv2:name "Max Time (ms)";
    lv2:default 20000.0;
    lv2:minimum 0.1;
    lv2:maximum 20000.0;
],
[
    a lv2:InputPort, lv2:ControlPort;
    lv2:index 10;
    lv2:symbol "sync";
    lv2:name "Host Sync";
    lv2:default 1;
    lv2:minimum 0;
    lv2:maximum 1;
    lv2:portProperty lv2:integer, lv2:enumeration, lv2:toggled;
    lv2:scalePoint [ rdfs:label "Off (120 BPM)"; rdf:value 0 ] ;
    lv2:scalePoint [ rdfs:label "On";            rdf:value 1 ] ;
],
[
    a lv2:InputPort, atom:AtomPort;
    atom:bufferType atom:Sequence;
    atom:supports time:Position;
    lv2:index 11;
    lv2:symbol "control";
    lv2:name "Control";
]
.
